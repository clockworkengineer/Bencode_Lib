PROJECT_NAME           = "@PROJECT_NAME@"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
PROJECT_BRIEF          = "@PROJECT_DESCRIPTION@"
OUTPUT_DIRECTORY       = "@CMAKE_CURRENT_BINARY_DIR@/doxygen"
INPUT                  = "@CMAKE_CURRENT_SOURCE_DIR@/classes/include" "@CMAKE_CURRENT_SOURCE_DIR@/docs" "@CMAKE_CURRENT_SOURCE_DIR@/README.md"
USE_MDFILE_AS_MAINPAGE = "@CMAKE_CURRENT_SOURCE_DIR@/README.md"
RECURSIVE              = YES
FILE_PATTERNS          = *.hpp *.h *.md
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
SEARCHENGINE           = YES
GENERATE_TREEVIEW      = YES
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
